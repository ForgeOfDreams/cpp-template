{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset with common settings for all configurations.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BREAD_PROJECT_BUILD": "ON"
      }
    },
    {
      "name": "linux-debug-clang",
      "inherits": "base",
      "displayName": "Linux Debug Clang",
      "description": "Linux Debug build with Clang and strict warnings",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wcast-align -Wcast-qual -Wnull-dereference -Woverloaded-virtual -Wformat=2 -Werror"
      }
    },
    {
      "name": "linux-release-clang",
      "inherits": "base",
      "displayName": "Linux Release Clang",
      "description": "Linux Release build with Clang and strict warnings",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wformat=2 -Woverloaded-virtual -Wnull-dereference -Wnon-virtual-dtor -Wdouble-promotion -Wimplicit-fallthrough -Wmissing-declarations -Wswitch-enum -Wshadow=local -Werror"
      }
    },
    {
      "name": "windows-debug-clang",
      "inherits": "base",
      "displayName": "Windows Debug Clang",
      "description": "Windows Debug build with Clang and strict warnings",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wcast-align -Wcast-qual -Wnull-dereference -Woverloaded-virtual -Wformat=2"
      }
    },
    {
      "name": "windows-release-clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "displayName": "Windows Release Clang",
      "description": "Windows Release build with Clang and strict warnings",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wformat=2 -Woverloaded-virtual -Wnull-dereference -Wnon-virtual-dtor -Wdouble-promotion -Wimplicit-fallthrough -Wmissing-declarations -Wswitch-enum -Wshadow=local"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux-debug-clang",
      "configurePreset": "linux-debug-clang",
      "configuration": "Debug"
    },
    {
      "name": "build-linux-release-clang",
      "configurePreset": "linux-release-clang",
      "configuration": "Release"
    },
    {
      "name": "build-windows-debug-clang",
      "configurePreset": "windows-debug-clang",
      "configuration": "Debug"
    },
    {
      "name": "build-windows-release-clang",
      "configurePreset": "windows-release-clang",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "description": "Generic test preset using base configuration",
      "configurePreset": "base",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}